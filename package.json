{
  "name": "scene-sleuth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build --config vite.config.ts && vite build --config vite-content.config.ts && vite build --config vite-background.config.ts && node scripts/build-firefox.mjs && pnpm run build:check",
    "icons:svg": "node --experimental-strip-types scripts/write-icon-svgs.ts",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:check": "node scripts/check-build.mjs",
    "ui": "pnpm dlx shadcn@4.21.5",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "firefox:lint": "web-ext lint --source-dir dist-firefox --no-config-discovery",
    "firefox:run": "pnpm run build && web-ext run --source-dir dist-firefox --no-config-discovery",
    "firefox:package": "pnpm run build && pnpm run firefox:lint && web-ext build --source-dir dist-firefox --overwrite-dest --no-config-discovery"
  },
  "dependencies": {
    "@react-stately/flags": "3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
